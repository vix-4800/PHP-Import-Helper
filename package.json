{
  "name": "php-import-helper",
  "displayName": "PHP Import Helper",
  "description": "Import, expand, sort, diagnose, and manage PHP namespaces",
  "version": "0.2.4",
  "icon": "icon.png",
  "publisher": "vix",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "qna": false,
  "preview": true,
  "pricing": "Free",
  "author": {
    "name": "Anton VIX",
    "email": "Gordan.ei@protonmail.ch",
    "url": "https://github.com/vix-4800"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "php",
    "php imports",
    "php use statements",
    "phpdoc",
    "namespace",
    "class",
    "import",
    "imports",
    "expand",
    "composer",
    "autoload",
    "psr-4",
    "php8",
    "yii",
    "laravel"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "PHP Import Helper parses PHP source and updates imports without executing workspace code."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "PHP Import Helper needs filesystem access to index PHP classes and read composer.json."
    }
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "PHP Import Helper",
      "properties": {
        "phpImportHelper.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/vendor/**",
            "**/var/cache/**",
            "**/runtime/**",
            "**/storage/framework/**",
            "**/bootstrap/cache/**"
          ],
          "scope": "resource",
          "description": "Glob patterns excluded from PHP indexing and workspace class file search."
        },
        "phpImportHelper.autoSort": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Sort imports after adding a new import."
        },
        "phpImportHelper.autoFoldUses": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Fold import blocks when opening or switching PHP files."
        },
        "phpImportHelper.sortOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Sort imports on save."
        },
        "phpImportHelper.sortMode": {
          "type": "string",
          "enum": [
            "natural",
            "length",
            "alphabetical"
          ],
          "default": "natural",
          "scope": "resource",
          "description": "Import sort mode."
        },
        "phpImportHelper.leadingSeparator": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Prepend a leading backslash when expanding class names."
        },
        "phpImportHelper.removeOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Remove unused imports on save."
        },
        "phpImportHelper.removeDuplicateImports": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Remove duplicate class imports when cleaning imports."
        },
        "phpImportHelper.autoImportOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Import uniquely resolved classes on save."
        },
        "phpImportHelper.ignoreList": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Class names ignored by diagnostics."
        },
        "phpImportHelper.highlightNotImported": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report unimported classes."
        },
        "phpImportHelper.highlightNotUsed": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report unused imports."
        },
        "phpImportHelper.diagnostics.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "scope": "resource",
          "description": "Delay diagnostics refresh after PHP document edits."
        },
        "phpImportHelper.performance.trace": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Write diagnostics and index timing traces to the performance output channel."
        }
      }
    },
    "commands": [
      {
        "command": "phpImportHelper.import",
        "title": "Import Class",
        "category": "PHP Import Helper"
      },
      {
        "command": "phpImportHelper.importAll",
        "title": "Import All Classes",
        "category": "PHP Import Helper"
      },
      {
        "command": "phpImportHelper.expand",
        "title": "Expand Class",
        "category": "PHP Import Helper"
      },
      {
        "command": "phpImportHelper.sort",
        "title": "Sort Imports",
        "category": "PHP Import Helper"
      },
      {
        "command": "phpImportHelper.foldUses",
        "title": "Fold Imports",
        "category": "PHP Import Helper"
      },
      {
        "command": "phpImportHelper.removeUnused",
        "title": "Remove Unused Imports",
        "category": "PHP Import Helper"
      },
      {
        "command": "phpImportHelper.generateNamespace",
        "title": "Generate Namespace",
        "category": "PHP Import Helper"
      },
      {
        "command": "phpImportHelper.rebuildIndex",
        "title": "Rebuild Namespace Index",
        "category": "PHP Import Helper"
      },
      {
        "command": "phpImportHelper.showPerformanceStats",
        "title": "Show Performance Stats",
        "category": "PHP Import Helper"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == php",
          "command": "phpImportHelper.import",
          "group": "0_php_import_helper@1"
        },
        {
          "when": "resourceLangId == php",
          "command": "phpImportHelper.importAll",
          "group": "0_php_import_helper@2"
        },
        {
          "when": "resourceLangId == php",
          "command": "phpImportHelper.expand",
          "group": "0_php_import_helper@3"
        },
        {
          "when": "resourceLangId == php",
          "command": "phpImportHelper.sort",
          "group": "0_php_import_helper@4"
        },
        {
          "when": "resourceLangId == php",
          "command": "phpImportHelper.foldUses",
          "group": "0_php_import_helper@5"
        },
        {
          "when": "resourceLangId == php",
          "command": "phpImportHelper.removeUnused",
          "group": "0_php_import_helper@6"
        },
        {
          "when": "resourceLangId == php",
          "command": "phpImportHelper.generateNamespace",
          "group": "0_php_import_helper@7"
        },
        {
          "when": "resourceLangId == php",
          "command": "phpImportHelper.showPerformanceStats",
          "group": "0_php_import_helper@8"
        }
      ]
    },
    "keybindings": [
      {
        "command": "phpImportHelper.import",
        "key": "ctrl+alt+i",
        "when": "editorTextFocus && editorLangId == php"
      },
      {
        "command": "phpImportHelper.importAll",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus && editorLangId == php"
      },
      {
        "command": "phpImportHelper.expand",
        "key": "ctrl+alt+e",
        "when": "editorTextFocus && editorLangId == php"
      },
      {
        "command": "phpImportHelper.sort",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus && editorLangId == php"
      },
      {
        "command": "phpImportHelper.removeUnused",
        "key": "ctrl+alt+r",
        "when": "editorTextFocus && editorLangId == php"
      },
      {
        "command": "phpImportHelper.generateNamespace",
        "key": "ctrl+alt+g",
        "when": "editorTextFocus && editorLangId == php"
      }
    ]
  },
  "homepage": "https://github.com/vix-4800/PHP-Import-Helper",
  "repository": {
    "type": "git",
    "url": "https://github.com/vix-4800/PHP-Import-Helper.git"
  },
  "bugs": {
    "url": "https://github.com/vix-4800/PHP-Import-Helper/issues"
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm run package && vsce package",
    "package:pre-release": "npm run package && vsce package --pre-release",
    "compile-tests": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile-tests && npm run compile && node ./out/test/runTests.js"
  },
  "dependencies": {
    "php-parser": "^3.6.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "25.9.1",
    "typescript-eslint": "^8.59.4",
    "eslint": "^10.4.0",
    "esbuild": "^0.28.1",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
